{"title_zh":"长江和黄河","subtitle_zh":"两条大河，一个家","title_en":"Two Rivers","subtitle_en":"Two great rivers, one family","author":"Text and translation by Claude (Anthropic)","type":"meta"}
{"type":"p","id":"intro","segs":[{"en":"This summer, during the holidays, Xiaochuan took the train from Chongqing to Lanzhou to visit his grandfather.","tok":[["今年","jīnnián"],["夏天","xiàtiān"],["放假","fàngjià"],"，",["小川","Xiǎochuān","Xiaochuan (boy's name)","N"],["从","cóng"],["重庆","Chóngqìng","Chongqing (city on the Yangtze)","N"],["坐","zuò"],["火车","huǒchē"],["到","dào"],["兰州","Lánzhōu","Lanzhou (city on the Yellow River)","N"],"，",["来","lái"],["看","kàn"],["爷爷","yéye"],"。"]},{"en":"His younger cousin Xiaolan lived in Lanzhou, and she came to Grandpa's house every day to play with him.","tok":[["他","tā"],["的","de"],["表妹","biǎomèi"],["小兰","Xiǎolán","Xiaolan (girl's name)","N"],["就","jiù"],["住","zhù"],["在","zài"],["兰州","Lánzhōu","Lanzhou (city on the Yellow River)","N"],"，",["她","tā"],["天天","tiāntiān"],["来","lái"],["爷爷","yéye"],["家","jiā"],"，",["跟","gēn"],["小川","Xiǎochuān","Xiaochuan (boy's name)","N"],["一起","yīqǐ"],["玩","wán"],"。"]},{"en":"Grandpa's house was close to the Yellow River, only a ten-minute walk away.","tok":[["爷爷","yéye"],["家","jiā"],["离","lí"],["黄河","Huáng Hé","the Yellow River","N"],["很","hěn"],["近","jìn"],"，",["走路","zǒulù"],["十","shí"],["分钟","fēnzhōng"],["就","jiù"],["到","dào"],["了","le"],"。"]},{"en":"On the first evening, after dinner, Grandpa took the two children for a walk by the river.","tok":[["第一","dìyī"],["天","tiān"],["晚上","wǎnshang"],"，",["吃完","chīwán"],["晚饭","wǎnfàn"],"，",["爷爷","yéye"],["带","dài"],["两","liǎng"],["个","gè"],["孩子","háizi"],["去","qù"],["河边","hébiān"],["走","zǒu"],["走","zǒu"],"。"]}],"zh":"今年夏天放假，小川从重庆坐火车到兰州，来看爷爷。他的表妹小兰就住在兰州，她天天来爷爷家，跟小川一起玩。爷爷家离黄河很近，走路十分钟就到了。第一天晚上，吃完晚饭，爷爷带两个孩子去河边走走。"}
{"type":"h2","id":"h-whose","segs":[{"en":"Whose River Is Better?","tok":[["谁","shéi"],["的","de"],["河","hé"],["好","hǎo"],"？"]}],"zh":"谁的河好？"}
{"type":"p","id":"whose-1","segs":[{"en":"Xiaolan stood by the river and said loudly, “This is the Yellow River! Our Lanzhou is right on its banks. The Yellow River is the best river in China!”","tok":[["小兰","Xiǎolán","Xiaolan (girl's name)","N"],["站","zhàn"],["在","zài"],["河边","hébiān"],"，",["大声","dàshēng"],["说","shuō"],"：","“",["这","zhè"],["是","shì"],["黄河","Huáng Hé","the Yellow River","N"],"！",["我们","wǒmen"],["兰州","Lánzhōu","Lanzhou (city on the Yellow River)","N"],["就","jiù"],["在","zài"],["黄河","Huáng Hé","the Yellow River","N"],["边","biān"],["上","shàng"],"。",["黄河","Huáng Hé","the Yellow River","N"],["是","shì"],["中国","Zhōngguó"],["最好","zuìhǎo"],["的","de"],["河","hé"],"！","”"]},{"en":"Xiaochuan laughed. “The best river? Look, the water is yellow. It isn't pretty at all. Our Yangtze in Chongqing is much bigger than the Yellow River.”","tok":[["小川","Xiǎochuān","Xiaochuan (boy's name)","N"],["笑","xiào"],["了","le"],"：","“",["最好","zuìhǎo"],["的","de"],["河","hé"],"？",["你","nǐ"],["看","kàn"],"，",["黄河","Huáng Hé","the Yellow River","N"],["的","de"],["水","shuǐ"],["是","shì"],["黄","huáng"],["的","de"],"，",["一点儿","yīdiǎnr"],["也","yě"],["不","bù"],["好看","hǎokàn"],"。",["我们","wǒmen"],["重庆","Chóngqìng","Chongqing (city on the Yangtze)","N"],["的","de"],["长江","Cháng Jiāng","the Yangtze River","N"],["比","bǐ"],["黄河","Huáng Hé","the Yellow River","N"],["大","dà"],["多","duō"],["了","le"],"。","”"]},{"en":"Xiaolan got angry. “All right, the Yangtze is big, but the Yellow River is more famous!”","tok":[["小兰","Xiǎolán","Xiaolan (girl's name)","N"],["生气","shēngqì"],["了","le"],"：","“",["长江","Cháng Jiāng","the Yangtze River","N"],["是","shì"],["大","dà"],"，",["可是","kěshì"],["黄河","Huáng Hé","the Yellow River","N"],["比","bǐ"],["长江","Cháng Jiāng","the Yangtze River","N"],["有名","yǒumíng"],"！","”"]},{"en":"“The Yangtze is the longest river in China, did you know that?” said Xiaochuan.","tok":["“",["长江","Cháng Jiāng","the Yangtze River","N"],["是","shì"],["中国","Zhōngguó"],["最","zuì"],["长","cháng"],["的","de"],["河","hé"],"，",["你","nǐ"],["知道","zhīdào"],["吗","ma"],"？","”",["小川","Xiǎochuān","Xiaochuan (boy's name)","N"],["说","shuō"],"。"]},{"en":"The two of them went back and forth, and neither would give in.","tok":[["两","liǎng"],["个","gè"],["人","rén"],["你","nǐ"],["一","yī"],["句","jù"],"，",["我","wǒ"],["一","yī"],["句","jù"],"，",["谁","shéi"],["也","yě"],["不","bù"],["让","ràng"],["谁","shéi"],"。"]}],"zh":"小兰站在河边，大声说：“这是黄河！我们兰州就在黄河边上。黄河是中国最好的河！”小川笑了：“最好的河？你看，黄河的水是黄的，一点儿也不好看。我们重庆的长江比黄河大多了。”小兰生气了：“长江是大，可是黄河比长江有名！”“长江是中国最长的河，你知道吗？”小川说。两个人你一句，我一句，谁也不让谁。"}
{"type":"p","id":"whose-2","segs":[{"en":"Grandpa sat beside them, listening and smiling the whole time.","tok":[["爷爷","yéye"],["坐","zuò"],["在","zài"],["旁边","pángbiān"],"，",["一直","yīzhí"],["笑","xiào"],["着","zhe"],["听","tīng"],"。"]},{"en":"Xiaolan asked, “Grandpa, you tell us: is the Yangtze better, or the Yellow River?”","tok":[["小兰","Xiǎolán","Xiaolan (girl's name)","N"],["问","wèn"],"：","“",["爷爷","yéye"],"，",["你","nǐ"],["说","shuō"],"，",["长江","Cháng Jiāng","the Yangtze River","N"],["好","hǎo"],["还是","háishi"],["黄河","Huáng Hé","the Yellow River","N"],["好","hǎo"],"？","”"]},{"en":"“Yes, Grandpa, you tell us!” said Xiaochuan.","tok":[["小川","Xiǎochuān","Xiaochuan (boy's name)","N"],["也","yě"],["说","shuō"],"：","“",["对","duì"],"，",["爷爷","yéye"],"，",["你","nǐ"],["说","shuō"],["吧","ba"],"！","”"]},{"en":"Grandpa didn't answer right away.","tok":[["爷爷","yéye"],["没有","méiyǒu"],["马上","mǎshàng"],["回答","huídá"],"。"]},{"en":"He said, “Let's go home. First I'll tell you about these two rivers, and then you can tell me which one is better.”","tok":[["他","tā"],["说","shuō"],"：","“",["我们","wǒmen"],["回家","huíjiā"],["吧","ba"],"。",["我","wǒ"],["先","xiān"],["给","gěi"],["你们","nǐmen"],["讲","jiǎng"],["讲","jiǎng"],["这","zhè"],["两","liǎng"],["条","tiáo"],["河","hé"],"，",["然后","ránhòu"],["你们","nǐmen"],["再","zài"],["告诉","gàosu"],["我","wǒ"],"，",["哪","nǎ"],["条","tiáo"],["河","hé"],["好","hǎo"],"。","”"]}],"zh":"爷爷坐在旁边，一直笑着听。小兰问：“爷爷，你说，长江好还是黄河好？”小川也说：“对，爷爷，你说吧！”爷爷没有马上回答。他说：“我们回家吧。我先给你们讲讲这两条河，然后你们再告诉我，哪条河好。”"}
{"type":"h2","id":"h-yangtze","segs":[{"en":"The Yangtze","tok":[["长江","Cháng Jiāng","the Yangtze River","N"]]}],"zh":"长江"}
{"type":"p","id":"yangtze-1","segs":[{"en":"Back home, Grandpa took out the family's map of China and laid it on the table.","tok":[["回到","huídào"],["家","jiā"],"，",["爷爷","yéye"],["拿出","náchū"],["家里","jiāli"],["的","de"],["中国","Zhōngguó"],["地图","dìtú"],"，",["放","fàng"],["在","zài"],["桌子","zhuōzi"],["上","shàng"],"。"]},{"en":"He asked Xiaochuan to find the Yangtze on the map first.","tok":[["他","tā"],["让","ràng"],["小川","Xiǎochuān","Xiaochuan (boy's name)","N"],["先","xiān"],["在","zài"],["地图","dìtú"],["上","shàng"],["找","zhǎo"],["长江","Cháng Jiāng","the Yangtze River","N"],"。"]},{"en":"Xiaochuan found it quickly. “Here! The Yangtze flows from the west to the east, passes Chongqing, and finally flows into the sea at Shanghai.”","tok":[["小川","Xiǎochuān","Xiaochuan (boy's name)","N"],["很","hěn"],["快","kuài"],["就","jiù"],["找到","zhǎodào"],["了","le"],"：","“",["在","zài"],["这儿","zhèr"],"！",["长江","Cháng Jiāng","the Yangtze River","N"],["从","cóng"],["西边","xībian"],["流","liú"],["到","dào"],["东边","dōngbian"],"，",["经过","jīngguò"],["重庆","Chóngqìng","Chongqing (city on the Yangtze)","N"],"，",["最后","zuìhòu"],["在","zài"],["上海","Shànghǎi","Shanghai","N"],["流","liú"],["进","jìn"],["大海","dàhǎi"],"。","”"]},{"en":"“That's right,” said Grandpa. “The Yangtze is more than six thousand three hundred kilometres long. It is the longest river in China.”","tok":[["爷爷","yéye"],["说","shuō"],"：","“",["对","duì"],"。",["长江","Cháng Jiāng","the Yangtze River","N"],["有","yǒu"],["六","liù"],["千","qiān"],["三","sān"],["百","bǎi"],["多","duō"],["公里","gōnglǐ"],"，",["是","shì"],["中国","Zhōngguó"],["最","zuì"],["长","cháng"],["的","de"],["河","hé"],"。","”"]}],"zh":"回到家，爷爷拿出家里的中国地图，放在桌子上。他让小川先在地图上找长江。小川很快就找到了：“在这儿！长江从西边流到东边，经过重庆，最后在上海流进大海。”爷爷说：“对。长江有六千三百多公里，是中国最长的河。”"}
{"type":"p","id":"yangtze-2","segs":[{"en":"Grandpa went on, “The Yangtze is not only long, it also carries a lot of water, much more than the Yellow River. There are many big boats on the Yangtze, and you can go by boat all the way from Chongqing to Shanghai.”","tok":[["爷爷","yéye"],["又","yòu"],["说","shuō"],"：","“",["长江","Cháng Jiāng","the Yangtze River","N"],["不但","bùdàn"],["很","hěn"],["长","cháng"],"，",["而且","érqiě"],["水","shuǐ"],["很","hěn"],["多","duō"],"，",["长江","Cháng Jiāng","the Yangtze River","N"],["的","de"],["水","shuǐ"],["比","bǐ"],["黄河","Huáng Hé","the Yellow River","N"],["多","duō"],["很","hěn"],["多","duō"],"。",["在","zài"],["长江","Cháng Jiāng","the Yangtze River","N"],["上","shàng"],["有","yǒu"],["很","hěn"],["多","duō"],["大","dà"],["船","chuán"],"，",["从","cóng"],["重庆","Chóngqìng","Chongqing (city on the Yangtze)","N"],["可以","kěyǐ"],["一直","yīzhí"],["坐","zuò"],["船","chuán"],["到","dào"],["上海","Shànghǎi","Shanghai","N"],"。","”"]},{"en":"Xiaochuan said happily, “See? The Yangtze is better than the Yellow River!”","tok":[["小川","Xiǎochuān","Xiaochuan (boy's name)","N"],["高兴","gāoxìng"],["地","de"],["说","shuō"],"：","“",["你","nǐ"],["看","kàn"],"，",["长江","Cháng Jiāng","the Yangtze River","N"],["比","bǐ"],["黄河","Huáng Hé","the Yellow River","N"],["好","hǎo"],["吧","ba"],"！","”"]},{"en":"Grandpa laughed. “Not so fast. There's still the Yellow River.”","tok":[["爷爷","yéye"],["笑","xiào"],["了","le"],"：","“",["别","bié"],["急","jí"],"，",["还有","háiyǒu"],["黄河","Huáng Hé","the Yellow River","N"],["呢","ne"],"。","”"]}],"zh":"爷爷又说：“长江不但很长，而且水很多，长江的水比黄河多很多。在长江上有很多大船，从重庆可以一直坐船到上海。”小川高兴地说：“你看，长江比黄河好吧！”爷爷笑了：“别急，还有黄河呢。”"}
{"type":"h2","id":"h-yellow","segs":[{"en":"The Yellow River","tok":[["黄河","Huáng Hé","the Yellow River","N"]]}],"zh":"黄河"}
{"type":"p","id":"yellow-1","segs":[{"en":"Xiaolan found the Yellow River on the map at once.","tok":[["小兰","Xiǎolán","Xiaolan (girl's name)","N"],["马上","mǎshàng"],["在","zài"],["地图","dìtú"],["上","shàng"],["找到","zhǎodào"],["了","le"],["黄河","Huáng Hé","the Yellow River","N"],"。"]},{"en":"The Yellow River also flows from the west to the east, passes Lanzhou, and finally flows into the sea.","tok":[["黄河","Huáng Hé","the Yellow River","N"],["也","yě"],["是","shì"],["从","cóng"],["西边","xībian"],["流","liú"],["到","dào"],["东边","dōngbian"],"，",["经过","jīngguò"],["兰州","Lánzhōu","Lanzhou (city on the Yellow River)","N"],"，",["最后","zuìhòu"],["流","liú"],["进","jìn"],["大海","dàhǎi"],"。"]},{"en":"“How long is the Yellow River?” asked Xiaolan.","tok":["“",["黄河","Huáng Hé","the Yellow River","N"],["有","yǒu"],["多","duō"],["长","cháng"],"？","”",["小兰","Xiǎolán","Xiaolan (girl's name)","N"],["问","wèn"],"。"]},{"en":"“The Yellow River is more than five thousand four hundred kilometres long. It is the second-longest river in China,” said Grandpa. “It isn't as long as the Yangtze, but it is very long too.”","tok":["“",["黄河","Huáng Hé","the Yellow River","N"],["有","yǒu"],["五","wǔ"],["千","qiān"],["四","sì"],["百","bǎi"],["多","duō"],["公里","gōnglǐ"],"，",["是","shì"],["中国","Zhōngguó"],["第二","dì'èr"],["长","cháng"],["的","de"],["河","hé"],"。","”",["爷爷","yéye"],["说","shuō"],"，","“",["它","tā"],["没有","méiyǒu"],["长江","Cháng Jiāng","the Yangtze River","N"],["那么","nàme"],["长","cháng"],"，",["可是","kěshì"],["也","yě"],["很","hěn"],["长","cháng"],"。","”"]}],"zh":"小兰马上在地图上找到了黄河。黄河也是从西边流到东边，经过兰州，最后流进大海。“黄河有多长？”小兰问。“黄河有五千四百多公里，是中国第二长的河。”爷爷说，“它没有长江那么长，可是也很长。”"}
{"type":"p","id":"yellow-2","segs":[{"en":"Xiaochuan asked, “Why is the water of the Yellow River yellow?”","tok":[["小川","Xiǎochuān","Xiaochuan (boy's name)","N"],["问","wèn"],"：","“",["黄河","Huáng Hé","the Yellow River","N"],["的","de"],["水","shuǐ"],["为什么","wèishénme"],["是","shì"],["黄色","huángsè"],["的","de"],"？","”"]},{"en":"Grandpa said, “Because the Yellow River flows across the Loess Plateau, where the hills are all yellow. The river carries away a lot of that yellow earth, so its water turns yellow.”","tok":[["爷爷","yéye"],["说","shuō"],"：","“",["因为","yīnwèi"],["黄河","Huáng Hé","the Yellow River","N"],["流","liú"],["过","guò"],["黄土高原","Huángtǔ Gāoyuán","the Loess Plateau","N"],"，",["那里","nàlǐ"],["的","de"],["山","shān"],["都","dōu"],["是","shì"],["黄色","huángsè"],["的","de"],"。",["河水","héshuǐ"],["从","cóng"],["那里","nàlǐ"],["带走","dàizǒu"],["很","hěn"],["多","duō"],["黄色","huángsè"],["的","de"],["东西","dōngxi"],"，",["所以","suǒyǐ"],["黄河","Huáng Hé","the Yellow River","N"],["的","de"],["水","shuǐ"],["就","jiù"],["变","biàn"],["黄","huáng"],["了","le"],"。","”"]}],"zh":"小川问：“黄河的水为什么是黄色的？”爷爷说：“因为黄河流过黄土高原，那里的山都是黄色的。河水从那里带走很多黄色的东西，所以黄河的水就变黄了。”"}
{"type":"p","id":"yellow-3","segs":[{"en":"Grandpa went on, “Long, long ago, many Chinese people already lived along the Yellow River. They ate, lived, wrote and painted by the river. That is why Chinese people say the Yellow River is like a mother.”","tok":[["爷爷","yéye"],["又","yòu"],["说","shuō"],"：","“",["很","hěn"],["早","zǎo"],["以前","yǐqián"],"，",["很","hěn"],["多","duō"],["中国人","Zhōngguórén"],["就","jiù"],["住","zhù"],["在","zài"],["黄河","Huáng Hé","the Yellow River","N"],["边","biān"],["上","shàng"],"，",["在","zài"],["河边","hébiān"],["吃饭","chīfàn"],"、",["生活","shēnghuó"],"、",["写字","xiězì"],"、",["画","huà"],["画儿","huàr"],"。",["所以","suǒyǐ"],["中国人","Zhōngguórén"],["说","shuō"],"，",["黄河","Huáng Hé","the Yellow River","N"],["像","xiàng"],["妈妈","māma"],["一样","yīyàng"],"。","”"]},{"en":"Xiaolan said happily, “Did you hear that? The Yellow River is like a mother!”","tok":[["小兰","Xiǎolán","Xiaolan (girl's name)","N"],["高兴","gāoxìng"],["地","de"],["说","shuō"],"：","“",["你","nǐ"],["听","tīng"],"，",["黄河","Huáng Hé","the Yellow River","N"],["跟","gēn"],["妈妈","māma"],["一样","yīyàng"],"！","”"]},{"en":"Xiaochuan thought for a moment and said, “What about the Yangtze? Lots of people live along the Yangtze too.”","tok":[["小川","Xiǎochuān","Xiaochuan (boy's name)","N"],["想","xiǎng"],["了","le"],["想","xiǎng"],"，",["说","shuō"],"：","“",["那","nà"],["长江","Cháng Jiāng","the Yangtze River","N"],["呢","ne"],"？",["长江","Cháng Jiāng","the Yangtze River","N"],["边","biān"],["上","shàng"],["也","yě"],["住","zhù"],["着","zhe"],["很","hěn"],["多","duō"],["人","rén"],"。","”"]},{"en":"“Right,” said Grandpa. “The Yangtze is just like the Yellow River, a mother too. The two rivers gave us not only water and fish, but also our homes.”","tok":[["爷爷","yéye"],["说","shuō"],"：","“",["对","duì"],"，",["长江","Cháng Jiāng","the Yangtze River","N"],["跟","gēn"],["黄河","Huáng Hé","the Yellow River","N"],["一样","yīyàng"],"，",["也","yě"],["像","xiàng"],["妈妈","māma"],"。",["两","liǎng"],["条","tiáo"],["河","hé"],["不但","bùdàn"],["给","gěi"],["了","le"],["我们","wǒmen"],["水","shuǐ"],["和","hé"],["鱼","yú"],"，",["而且","érqiě"],["给","gěi"],["了","le"],["我们","wǒmen"],["家","jiā"],"。","”"]}],"zh":"爷爷又说：“很早以前，很多中国人就住在黄河边上，在河边吃饭、生活、写字、画画儿。所以中国人说，黄河像妈妈一样。”小兰高兴地说：“你听，黄河跟妈妈一样！”小川想了想，说：“那长江呢？长江边上也住着很多人。”爷爷说：“对，长江跟黄河一样，也像妈妈。两条河不但给了我们水和鱼，而且给了我们家。”"}
