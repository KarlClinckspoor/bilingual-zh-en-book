# My Chinese Friend — original story and translation by Claude (Anthropic).
# Target: HSK 3.0 level 1; focus grammar: 吗 / 呢 questions, 会 / 能, 也 / 都; names N.

@meta {"title_zh": "我的中国朋友", "subtitle_zh": "你教我，我教你", "title_en": "My Chinese Friend", "subtitle_en": "You teach me, I teach you", "author": "Text and translation by Claude (Anthropic)"}

